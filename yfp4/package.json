{
    "name": "@yetiforce/portal4",
    "version": "4.0.1",
    "author": "YetiForceCompany <info@yetiforce.com> (https://yetiforce.com)",
    "license": "YetiForce Commercial License (more in licenses/License.txt)",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build && pnpm license-pkg",
        "dist": "bash scripts/deploy/make-dist.sh dist",
        "license-pkg": "pnpm licenses list --json | node scripts/license-json.mjs > License.json && pnpm licenses list > License.log",
        "upgrade-package": "pnpm update --interactive --latest",
        "start": "pnpm dist && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server.js",
        "lint": "biome check",
        "format": "biome format --write",
        "typecheck": "next typegen && tsc --noEmit",
        "check": "biome check",
        "codegen": "orval --config orval.config.ts",
        "prepare": "husky",
        "skills:update": "npx skills update"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fortawesome/fontawesome-free": "6.7.2",
        "@hookform/resolvers": "^5.9.1",
        "@mdi/font": "7.4.47",
        "@serwist/turbopack": "9.5.12",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tabler/icons-webfont": "3.34.1",
        "@tanstack/react-query": "^5.102.3",
        "@tanstack/react-query-persist-client": "^5.102.3",
        "@tanstack/react-table": "^9.1.2",
        "@tiptap/pm": "^3.30.3",
        "@tiptap/react": "^3.30.3",
        "@tiptap/starter-kit": "^3.30.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "device-uuid": "1.0.4",
        "flag-icons": "6.15.0",
        "jose": "^6.2.10",
        "lucide-react": "^1.34.0",
        "next": "16.3.2",
        "next-intl": "^4.13.7",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.86.0",
        "serwist": "^9.5.12",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^26.3.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19.2.5",
        "esbuild": "^0.28.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "orval": "^8.26.0",
        "tailwindcss": "^4",
        "typescript": "^7.0.2"
    },
    "browserslist": [
        "last 2 version",
        "> 1%"
    ],
    "packageManager": "pnpm@12.3.1",
    "engines": {
        "node": ">=26"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,jsonc}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    }
}
